# Point this at the MMBM-Backend Odoo instance.
# Local dev (default docker-compose.yml):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8069

# Production (Vercel): set NEXT_PUBLIC_API_BASE_URL as an Environment
# Variable in the Vercel project settings, pointing at the public Odoo URL
# (e.g. the Cloudflare Tunnel URL, or wherever the backend is hosted).
